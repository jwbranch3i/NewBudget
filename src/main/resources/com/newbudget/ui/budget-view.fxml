<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.newbudget.ui.BudgetViewController" prefHeight="900.0" prefWidth="1600.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>
    <top>
        <HBox spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onPreviousMonth" styleClass="month-nav-button" text="◀ Previous" />
                <Button mnemonicParsing="false" onAction="#onNextMonth" styleClass="month-nav-button" text="Next ▶" />
                <Label styleClass="month-label" text="Month:" />
                <ComboBox fx:id="monthPicker" styleClass="month-picker" />
                <Button mnemonicParsing="false" onAction="#onImportCsv" styleClass="action-button" text="Import Actuals CSV" />
                <Button mnemonicParsing="false" onAction="#onUseCurrentMonth" styleClass="secondary-button" text="Use Current Month" />
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="12.0" styleClass="sections-root">
            <children>
                <VBox spacing="6.0" styleClass="section-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-label" text="INCOME" />
                        <TreeTableView fx:id="incomeTable" editable="true" showRoot="false" styleClass="budget-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TreeTableColumn fx:id="incomeCategoryColumn" prefWidth="290.0" text="Category" />
                                <TreeTableColumn fx:id="incomeActualColumn" prefWidth="110.0" text="Actual" />
                                <TreeTableColumn fx:id="incomeBudgetColumn" prefWidth="110.0" text="Budget" />
                                <TreeTableColumn fx:id="incomeDifferenceColumn" prefWidth="110.0" text="Diff" />
                                <TreeTableColumn fx:id="incomeBalanceColumn" prefWidth="110.0" text="Balance" />
                            </columns>
                        </TreeTableView>
                        <GridPane styleClass="totals-row">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="290.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                            </columnConstraints>
                            <children>
                                <Label styleClass="totals-cell totals-title" text="TOTAL" GridPane.columnIndex="0" />
                                <Label fx:id="incomeActualTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="1" />
                                <Label fx:id="incomeBudgetTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="2" />
                                <Label fx:id="incomeDifferenceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="3" />
                                <Label fx:id="incomeBalanceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="4" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
                <VBox spacing="6.0" styleClass="section-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-label" text="MANDATORY" />
                        <TreeTableView fx:id="mandatoryTable" editable="true" showRoot="false" styleClass="budget-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TreeTableColumn fx:id="mandatoryCategoryColumn" prefWidth="290.0" text="Category" />
                                <TreeTableColumn fx:id="mandatoryActualColumn" prefWidth="110.0" text="Actual" />
                                <TreeTableColumn fx:id="mandatoryBudgetColumn" prefWidth="110.0" text="Budget" />
                                <TreeTableColumn fx:id="mandatoryDifferenceColumn" prefWidth="110.0" text="Diff" />
                                <TreeTableColumn fx:id="mandatoryBalanceColumn" prefWidth="110.0" text="Balance" />
                            </columns>
                        </TreeTableView>
                        <GridPane styleClass="totals-row">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="290.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                            </columnConstraints>
                            <children>
                                <Label styleClass="totals-cell totals-title" text="TOTAL" GridPane.columnIndex="0" />
                                <Label fx:id="mandatoryActualTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="1" />
                                <Label fx:id="mandatoryBudgetTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="2" />
                                <Label fx:id="mandatoryDifferenceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="3" />
                                <Label fx:id="mandatoryBalanceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="4" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
                <VBox spacing="6.0" styleClass="section-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-label" text="DISCRETIONARY" />
                        <TreeTableView fx:id="discretionaryTable" editable="true" showRoot="false" styleClass="budget-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TreeTableColumn fx:id="discretionaryCategoryColumn" prefWidth="290.0" text="Category" />
                                <TreeTableColumn fx:id="discretionaryActualColumn" prefWidth="110.0" text="Actual" />
                                <TreeTableColumn fx:id="discretionaryBudgetColumn" prefWidth="110.0" text="Budget" />
                                <TreeTableColumn fx:id="discretionaryDifferenceColumn" prefWidth="110.0" text="Diff" />
                                <TreeTableColumn fx:id="discretionaryBalanceColumn" prefWidth="110.0" text="Balance" />
                            </columns>
                        </TreeTableView>
                        <GridPane styleClass="totals-row">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="290.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                                <ColumnConstraints prefWidth="110.0" />
                            </columnConstraints>
                            <children>
                                <Label styleClass="totals-cell totals-title" text="TOTAL" GridPane.columnIndex="0" />
                                <Label fx:id="discretionaryActualTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="1" />
                                <Label fx:id="discretionaryBudgetTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="2" />
                                <Label fx:id="discretionaryDifferenceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="3" />
                                <Label fx:id="discretionaryBalanceTotal" styleClass="totals-cell" text="\$0.00" GridPane.columnIndex="4" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
    <bottom>
        <VBox alignment="CENTER" spacing="6.0" styleClass="bottom-summary" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="selectedMonthLabel" styleClass="selected-month-label" />
                <Label fx:id="statusLabel" styleClass="status-label" text="Ready" />
            </children>
        </VBox>
    </bottom>
</BorderPane>